---
import type { Person } from '../data/event';
import { contentUrl } from '../lib/urls';
interface Props { person: Person; }
const { person } = Astro.props;
---
<article class="person-panel">
  <div class="person-portrait">
    {person.portrait ? <img src={contentUrl(person.portrait)} alt={person.name} width="217" height="280" loading="lazy" /> : <span>Portrait coming soon</span>}
  </div>
  <h2 class="person-name">{person.profileUrl ? <a href={contentUrl(person.profileUrl)}>{person.name}</a> : person.name}</h2>
  <p>Organizing Committee</p>
  {person.title && <p>{person.title}</p>}
  {person.affiliation && <p>{person.affiliation}</p>}
  {person.biography && <p class="person-bio">{person.biography}</p>}
</article>
