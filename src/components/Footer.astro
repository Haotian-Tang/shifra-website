---
import { event, navigation } from '../data/event';
import { sitePath, contentUrl } from '../lib/urls';
---
<footer class="site-footer container">
  <p><strong>{event.name}</strong> · {event.displayDate}</p>
  <p>{event.venue} · {event.institutionShort}</p>
  <nav aria-label="Footer navigation">
    {navigation.map(item => <a href={sitePath(item.path)}>{item.label}</a>)}
    {event.registrationUrl && <a href={contentUrl(event.registrationUrl)}>Registration</a>}
  </nav>
  {event.contactEmail && <p><a href={`mailto:${event.contactEmail}`}>{event.contactEmail}</a></p>}
</footer>
