---
import { registrationUrl } from '../data/registration';
import { event } from '../data/event';
import registrationPreview from '../../integrations/google-apps-script/Registration.html?raw';
---
<section id="registration" class="home-section single-page-section registration-section container" aria-labelledby="registration-title">
  <span id="abstract-submission" class="section-anchor" aria-hidden="true"></span>
  <span id="poster-registration" class="section-anchor" aria-hidden="true"></span>
  {event.isArchived ? <>
    <h2 id="registration-title" class="section-title">Registration closed</h2>
    <p class="registration-intro">SHIFRA took place on 27 November 2026. Registration and abstract submissions are now closed.</p>
  </> : <>
  <h2 id="registration-title" class="section-title">Register for our symposium</h2>
  <p class="registration-intro">Join SHIFRA as an audience member, or submit an abstract for consideration for a poster presentation or a selected talk.</p>
  <p class="registration-deadline"><strong>Abstract submission deadline:</strong> <time datetime="2026-11-24T23:59:00+04:00">Tuesday, 24 November 2026 at 11:59 PM</time><br />UAE time (GST, UTC+4)</p>
  <div class="registration-embed">
    <iframe title="Register for SHIFRA" src={registrationUrl || undefined} srcdoc={registrationUrl ? undefined : registrationPreview} width="760" height="900" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
  </div>
  {registrationUrl && <p class="registration-window"><a href={registrationUrl} target="_blank" rel="noopener noreferrer">Open registration in a new window <span aria-hidden="true">↗</span></a></p>}
  </>}
</section>
<script>
  const frame = document.querySelector<HTMLIFrameElement>('.registration-embed iframe');
  if (frame) window.addEventListener('message', (event: MessageEvent) => {
    const localPreview = event.origin === window.location.origin && event.source === frame.contentWindow;
    let googleFrame = false;
    try { const origin = new URL(event.origin); googleFrame = origin.protocol === 'https:' && (origin.hostname === 'script.google.com' || origin.hostname.endsWith('.googleusercontent.com')); } catch {}
    if ((!localPreview && !googleFrame) || event.data?.type !== 'SHIFRA_REGISTRATION_HEIGHT') return;
    const height = event.data.height;
    // The expanded abstract form includes speaker interest and recording consent;
    // allow their wrapped text on narrow phones while keeping resize messages bounded.
    if (typeof height === 'number' && Number.isFinite(height) && height >= 200 && height <= 4000) frame.style.height = `${Math.max(380, Math.ceil(height) + 64)}px`;
  });
</script>
