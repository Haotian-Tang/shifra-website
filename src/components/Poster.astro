---
import { event } from '../data/event';
import { contentUrl } from '../lib/urls';
---
<figure class="poster-block">
  <div class="poster-frame">
    {event.poster.image ? <img src={contentUrl(event.poster.image)} alt={event.poster.alt} width="600" height="900" loading="lazy" /> : <p>Poster coming soon</p>}
  </div>
  {event.poster.download && <figcaption><a href={contentUrl(event.poster.download)} download>Download poster</a></figcaption>}
</figure>
