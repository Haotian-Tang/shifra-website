---
import { event } from '../data/event';
const email = event.abstractSubmissionEmail;
const subject = 'SHIFRA abstract submission';
const body = 'Full name:\nAffiliation:\nAbstract title:\nPresentation preference (poster or talk, if any):\n\nAbstract:\n';
const emailUrl = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
---
<section id="abstract-submission" class="home-section single-page-section abstract-section container" aria-labelledby="abstract-title">
  <span id="registration" class="section-anchor" aria-hidden="true"></span>
  <span id="poster-registration" class="section-anchor" aria-hidden="true"></span>
  <h2 id="abstract-title" class="section-title">Submit an abstract</h2>
  <div class="abstract-callout">
    <p class="submission-options">Poster presentations &amp; selected talks</p>
    <p>Share your research with the SHIFRA community. Email your abstract for consideration for a poster presentation or a selected talk.</p>
    <h3>Rolling review</h3>
    <p>Abstracts are reviewed on a rolling basis. The organizers will respond by email with a decision and presentation details.</p>
    <h3>What to include</h3>
    <p>Please include your full name, affiliation, abstract title, and abstract text. If you have a presentation preference, mention whether you would prefer a poster or a talk.</p>
    <Fragment set:html="<!--email_off-->" />
    <a class="primary-button" href={emailUrl}>Email your abstract</a>
    <p class="submission-email">Send to <a href={`mailto:${email}`}>{email}</a>.</p>
    <Fragment set:html="<!--/email_off-->" />
  </div>
</section>
