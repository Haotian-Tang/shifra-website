---
import Layout from '../layouts/Layout.astro';
import AgendaEntry from '../components/AgendaEntry.astro';
import { event } from '../data/event';
import { agenda } from '../data/agenda';
---
<Layout title="Agenda" description="Explore the provisional SHIFRA Symposium programme for 27 November 2026: scientific talks, poster pitches, research exchange, and networking. All times are UAE time, GST (UTC+4)." current="agenda/">
  <div class="page-heading agenda-heading container"><h1>Agenda</h1></div>
  <section class="agenda-section container" aria-label="Chronological agenda">
    <div class="agenda-summary">
      <h2><time datetime={event.date}>{event.displayDate}</time></h2>
      <p>{event.timezoneLabel}</p>
      <p><strong>{event.programmeStatus}</strong><br />{event.confirmationNote}</p>
      <button class="print-button" type="button" hidden>Print agenda</button>
    </div>
    <ol class="agenda-list">{agenda.map(entry => <AgendaEntry entry={entry} />)}</ol>
    <p class="agenda-footnote">All times are shown in UAE time — GST, UTC+4 ({event.timezone}).</p>
  </section>
</Layout>
<script>
  const printButton = document.querySelector<HTMLButtonElement>('.print-button');
  if (printButton) {
    printButton.hidden = false;
    printButton.addEventListener('click', () => window.print());
  }
</script>
