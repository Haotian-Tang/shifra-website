---
import Layout from '../layouts/Layout.astro';
import Poster from '../components/Poster.astro';
import Countdown from '../components/Countdown.astro';
import AgendaSection from '../components/AgendaSection.astro';
import Registration from '../components/Registration.astro';
import { event } from '../data/event';
import { sitePath, contentUrl } from '../lib/urls';
---
<Layout title={event.theme} description={`SHIFRA Symposium brings genomics and artificial intelligence into conversation. ${event.displayDate} at ${event.venue}, ${event.institution}, ${event.city}. Explore the programme and register to attend or submit an abstract for posters and selected talks.`}>
  <div class="event-banner">
    <div class="banner-panel">{event.banner.image ? <picture>
      <source media="(max-width: 767px)" srcset={contentUrl(event.banner.mobileImage)} width="2400" height="1350" />
      <img src={contentUrl(event.banner.image)} alt={event.banner.alt} width="2172" height="724" fetchpriority="high" decoding="async" />
    </picture> : <span>Symposium banner coming soon</span>}</div>
  </div>
  <section class="home-hero" aria-labelledby="event-title">
    <div class="home-intro container">
      <h1 id="event-title" class="home-title"><span>{event.name}</span><span>{event.theme}</span></h1>
      <p class="event-date"><time datetime={event.date}>{event.displayDate}</time></p>
      <p class="event-location"><span>{event.venue}</span> · <span>{event.institution}</span></p>
      <div class="home-actions">
        <a class="primary-button" href={sitePath('#registration')}>Register for our symposium</a>
      </div>
      <p class="home-registration-note">You can submit your abstract here when you register.</p>
      <p class="abstract-deadline">Abstract submission deadline: <time datetime="2026-11-24T23:59:00+04:00">Tuesday, 24 November 2026, 11:59 PM</time> · UAE time (GST, UTC+4)</p>
    </div>
  </section>
  <section id="about" class="home-section about-section container" aria-labelledby="about-title">
    <div class="about-layout">
      <div class="about-copy-column">
        <h2 id="about-title" class="section-title">About the symposium</h2>
        <div class="home-copy">
          <p>{event.introduction}</p>
          <p>{event.story}</p>
          <ul class="about-opportunities">{event.opportunities.map(opportunity => <li>{opportunity}</li>)}</ul>
          <p>{event.community}</p>
          <p class="about-tagline">{event.tagline}</p>
        </div>
      </div>
      <aside class="about-poster" aria-label="Symposium poster"><h3>Symposium poster</h3><Poster /></aside>
    </div>
  </section>
  <AgendaSection />
  <Registration />
  <section id="location" class="home-section venue-section container" aria-labelledby="venue-title">
    <h2 id="venue-title" class="section-title">Location/Venue</h2>
    <p class="venue-name">{event.venue}</p>
    <p class="venue-institution">{event.institution} ({event.institutionShort})<br />{event.city}</p>
    <div class="venue-map"><iframe title="Google Maps: Mohamed bin Zayed University of Artificial Intelligence, Abu Dhabi" src={event.mapsEmbedUrl} width="900" height="340" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe></div>
    <a class="map-link" href={event.mapsUrl} target="_blank" rel="noopener noreferrer">Open location in Google Maps <span aria-hidden="true">↗</span></a>
  </section>
  <section class="home-section acknowledgement-section container" aria-labelledby="acknowledgement-title">
    <h2 id="acknowledgement-title" class="section-title">Acknowledgement</h2>
    {event.acknowledgement.map(paragraph => <p>{paragraph}</p>)}
  </section>
  <Countdown />
</Layout>
