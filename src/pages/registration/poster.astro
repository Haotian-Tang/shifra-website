---
import Layout from '../../layouts/Layout.astro';
import { posterRegistration as registration } from '../../data/registration';
import { sitePath } from '../../lib/urls';
---
<Layout title="Register for poster" description="Submit your SHIFRA poster registration with your name, affiliation, email address, and a PDF of your poster." current="registration/poster/">
  <div class="page-heading registration-heading container"><h1>Register for poster</h1></div>
  <section class="poster-registration container" aria-label="Poster registration form">
    <a class="back-link" href={sitePath('registration/')}>Back to registration</a>
    {registration.isPreview && <div class="preview-notice"><strong>Preview form</strong><p>This form is being reviewed. Please use test details and a sample poster when trying it out.</p></div>}
    <p class="form-introduction">Complete your details and upload your poster as a PDF. All four fields are required.</p>
    {!registration.endpoint && <p class="form-closed" role="status">Poster registration will open soon. Submissions are not being collected yet.</p>}
    <form id="poster-form" action={registration.endpoint ?? undefined} method="post" enctype="multipart/form-data" data-endpoint={registration.endpoint} data-max-bytes={registration.maxFileBytes}>
      <fieldset disabled={!registration.endpoint}>
        <legend class="visually-hidden">Your details and poster</legend>
        <div class="form-field"><label for="full-name">Full name</label><input id="full-name" name="fullName" type="text" autocomplete="name" maxlength={registration.maxNameLength} required /></div>
        <div class="form-field"><label for="affiliation">Affiliation</label><input id="affiliation" name="affiliation" type="text" autocomplete="organization" maxlength={registration.maxAffiliationLength} aria-describedby="affiliation-hint" required /><p class="form-hint" id="affiliation-hint">Your institution or organization.</p></div>
        <div class="form-field"><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="email" maxlength={registration.maxEmailLength} required /></div>
        <div class="form-field"><label for="poster-file">Upload poster</label><input id="poster-file" name="poster" type="file" accept={registration.accept} aria-describedby="poster-file-hint poster-selection" required /><p id="poster-file-hint" class="form-hint">One PDF file, up to {registration.maxFileSizeMb} MB.</p><p id="poster-selection" class="form-hint" aria-live="polite"></p></div>
        <p id="form-error" class="form-error" role="alert" hidden></p>
        <p id="form-status" class="form-status" role="status"></p>
        <button class="primary-button form-submit" type="submit">Submit poster</button>
        <p class="form-hint">Your details and poster are submitted to the organizers for review. Submission does not confirm acceptance.</p>
      </fieldset>
    </form>
    <section id="submission-success" class="submission-success" tabindex="-1" hidden>
      <h2>Poster received</h2><p>Thank you. Your registration details and poster file have been saved for the organizers.</p>
      <p class="submission-reference">Submission reference: <strong id="submission-reference"></strong></p>
      <p>Submission does not confirm poster acceptance.</p><a href={sitePath('agenda/')}>View the agenda</a>
    </section>
  </section>
</Layout>
<script>
  const form = document.querySelector<HTMLFormElement>('#poster-form');
  const fileInput = document.querySelector<HTMLInputElement>('#poster-file');
  const selection = document.querySelector<HTMLElement>('#poster-selection');
  const error = document.querySelector<HTMLElement>('#form-error');
  const status = document.querySelector<HTMLElement>('#form-status');
  const submit = form?.querySelector<HTMLButtonElement>('[type="submit"]');
  let submitting = false;
  fileInput?.addEventListener('change', () => {
    fileInput.setCustomValidity('');
    const file = fileInput.files?.[0];
    if (selection) selection.textContent = file ? `${file.name} · ${(file.size / (1024 * 1024)).toFixed(2)} MB` : '';
  });
  if (form && fileInput && submit && error && status && form.dataset.endpoint) {
    form.addEventListener('submit', async e => {
      e.preventDefault();
      if (submitting) return;
      error.hidden = true;
      error.textContent = '';
      const file = fileInput.files?.[0];
      if (file && (!/\.pdf$/i.test(file.name) || (file.type && !['application/pdf', 'application/octet-stream'].includes(file.type)))) fileInput.setCustomValidity('Please select a PDF file.');
      else if (file && file.size > Number(form.dataset.maxBytes)) fileInput.setCustomValidity(`Please select a PDF of ${Number(form.dataset.maxBytes) / (1024 * 1024)} MB or less.`);
      else if (file && file.size === 0) fileInput.setCustomValidity('The selected file is empty. Please choose your poster PDF.');
      else fileInput.setCustomValidity('');
      if (!form.reportValidity()) return;
      submitting = true;
      submit.disabled = true;
      submit.textContent = 'Submitting…';
      status.textContent = 'Uploading your poster. Please wait for confirmation.';
      const controller = new AbortController();
      const timer = setTimeout(() => controller.abort(), 120000);
      try {
        const response = await fetch(form.dataset.endpoint!, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' }, credentials: 'omit', signal: controller.signal });
        const result = await response.json().catch(() => null);
        if (!response.ok || !result?.ok || typeof result.reference !== 'string') throw new Error(result?.error || 'Your poster could not be saved. Please try again.');
        document.querySelector('#submission-reference')!.textContent = result.reference;
        form.reset();
        form.hidden = true;
        document.querySelector<HTMLElement>('.form-introduction')!.hidden = true;
        const success = document.querySelector<HTMLElement>('#submission-success')!;
        success.hidden = false;
        success.focus();
      } catch (failure) {
        error.textContent = failure instanceof DOMException && failure.name === 'AbortError' ? 'The upload timed out. Your details are still here; please try again.' : failure instanceof Error ? failure.message : 'The upload failed. Please try again.';
        error.hidden = false;
        status.textContent = '';
      } finally {
        clearTimeout(timer);
        submitting = false;
        submit.disabled = false;
        submit.textContent = 'Submit poster';
      }
    });
  }
</script>
